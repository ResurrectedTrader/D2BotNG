<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>default</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace>D2BotNG</RootNamespace>
    <Version>0.0.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <BuildVariant Condition="'$(BuildVariant)' == ''">standalone</BuildVariant>
    <!-- Aptabase app key, supplied only by CI (-p:AptabaseAppKey=... from the
         APTABASE_APP_KEY secret) and never committed. The empty default is the
         deliberate "analytics off" sentinel: a local build reports nothing. -->
    <AptabaseAppKey Condition="'$(AptabaseAppKey)' == ''"></AptabaseAppKey>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildVariant</_Parameter1>
      <_Parameter2>$(BuildVariant)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AptabaseAppKey</_Parameter1>
      <_Parameter2>$(AptabaseAppKey)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="D2BotNG.Tests" />
  </ItemGroup>

  <!-- Embedded resources for item rendering (all under /assets/rendering/) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\Resources\*.dc6" LinkBase="wwwroot\assets\rendering\dc6" />
    <EmbeddedResource Include="..\..\Resources\*.dat" LinkBase="wwwroot\assets\rendering" />
    <EmbeddedResource Include="..\..\Resources\*.png" LinkBase="wwwroot\assets\rendering" />
    <!-- D2R item art: nine archives of concatenated PNGs plus the index that slices them. Served
         whole rather than unpacked, because a slice of an archive already IS a PNG file. -->
    <EmbeddedResource Include="..\..\Resources\hd\*" LinkBase="wwwroot\assets\rendering\hd" />
  </ItemGroup>

  <ItemGroup>
    <!-- gRPC -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageReference Include="Grpc.AspNetCore.Web" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="All" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Captured character state (data/ng/captures.db).
         The bundle is pinned explicitly: Microsoft.Data.Sqlite 10.0.0 resolves
         SQLitePCLRaw.lib.e_sqlite3 2.1.11, which carries a high-severity advisory
         (GHSA-2m69-gcr7-jv3q). 3.0.5 supersedes it. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />

    <!-- Discord -->
    <PackageReference Include="Discord.Net" Version="3.18.0" />

    <!-- WebView2 for GUI mode -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
  </ItemGroup>

  <!-- Proto files for server-side code generation -->
  <ItemGroup>
    <Protobuf Include="..\..\protos\*.proto" GrpcServices="Server" ProtoRoot="..\..\protos" />
  </ItemGroup>
  <!-- Backend-only archived proto shapes for settings migration.
       Kept out of protos/ so they are excluded from the frontend's buf generation. -->
  <ItemGroup>
    <Protobuf Include="Legacy\Protos\*.proto" GrpcServices="None" ProtoRoot="Legacy\Protos" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="..\..\docs\">
      <Link>docs</Link>
    </Folder>
  </ItemGroup>

  <!-- UI source files for incremental build detection -->
  <ItemGroup>
    <UISourceFiles Include="..\D2BotNG.UI\src\**\*" />
    <UISourceFiles Include="..\D2BotNG.UI\index.html" />
    <UISourceFiles Include="..\D2BotNG.UI\package.json" />
    <UISourceFiles Include="..\D2BotNG.UI\package-lock.json" />
    <UISourceFiles Include="..\D2BotNG.UI\vite.config.ts" />
    <UISourceFiles Include="..\D2BotNG.UI\tailwind.config.ts" />
    <UISourceFiles Include="..\D2BotNG.UI\tsconfig.json" />
    <UISourceFiles Include="..\D2BotNG.UI\tsconfig.node.json" />
    <UISourceFiles Include="..\D2BotNG.UI\postcss.config.js" />
    <UISourceFiles Include="..\D2BotNG.UI\eslint.config.js" />
    <UISourceFiles Include="..\D2BotNG.UI\buf.gen.yaml" />
    <UISourceFiles Include="..\..\protos\*.proto" />
  </ItemGroup>

  <PropertyGroup>
    <WebView2LoaderPreference>Static</WebView2LoaderPreference>
    <!-- Disable static web assets - we use embedded resources instead -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!-- Publish: dotnet publish -c Release (with self-contained or no-self-contained flag) -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Clean publish output: no IIS web.config, no XML docs, embed PDB -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- wwwroot is already embedded as EmbeddedResource, don't also publish as content -->
  <ItemGroup>
    <Content Remove="wwwroot\**\*" />
    <_ContentIncludedByDefault Remove="wwwroot\**\*" />
  </ItemGroup>

  <!--
    Build UI before C# build. Incremental: skips when no UI sources changed.
    Skip entirely with: dotnet build -p:SkipUIBuild=true
  -->
  <!-- Embed wwwroot files as resources for single-file deployment (lazy evaluation after BuildUI) -->
  <!-- Exclude rendering assets (explicitly included from Resources folder) -->
  <Target Name="CollectUIResources" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildUI">
    <ItemGroup>
      <EmbeddedResource Include="wwwroot\**\*" Exclude="wwwroot\assets\rendering\**" LinkBase="wwwroot" />
    </ItemGroup>
  </Target>

  <Target Name="FormatUI" BeforeTargets="BuildUI" Condition="'$(SkipUIBuild)' != 'true' And '$(RunFormat)' == 'true'">
    <Exec Command="npm run format" WorkingDirectory="..\D2BotNG.UI" ContinueOnError="true" />
  </Target>

  <Target Name="BuildUI"
          BeforeTargets="CollectUIResources"
          Condition="'$(SkipUIBuild)' != 'true'"
          Inputs="@(UISourceFiles)"
          Outputs="$(BaseIntermediateOutputPath)ui-build.stamp">
    <Exec Command="npm run build" WorkingDirectory="..\D2BotNG.UI" />
    <Touch Files="$(BaseIntermediateOutputPath)ui-build.stamp" AlwaysCreate="true" />
  </Target>

  <!--
    Auto-format C# code before compilation.
    Enable with: dotnet build -p:RunFormat=true

    The SOLUTION, not this project, because that is what CI verifies: the Format C# job runs
    `dotnet format` over D2BotNG.sln in verify mode, which covers the test project too. Formatting
    only this one left the tests unformatted however often this was run, and the first anyone knew
    of it was that job failing.
  -->
  <Target Name="FormatCode" BeforeTargets="BeforeBuild" Condition="'$(RunFormat)' == 'true'" Outputs=".format-always-run">
    <Exec Command="dotnet format $(MSBuildThisFileDirectory)..\..\D2BotNG.sln --verbosity quiet --no-restore" ContinueOnError="true" />
  </Target>

  <!--
    ReSharper code inspection after build.
    Requires: dotnet tool install -g jetbrains.resharper.globaltools
    Enable with: dotnet build -p:RunInspect=true
  -->
  <Target Name="InspectCode" AfterTargets="Build" Condition="'$(RunInspect)' == 'true'" Outputs=".inspect-always-run">
    <!-- Restore local tool from manifest (works on local clones, may fail on network drives) -->
    <Exec Command="dotnet tool restore" ContinueOnError="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" />
    <!-- Try local tool first (from dotnet tool restore) -->
    <Exec Command="dotnet jb inspectcode $(MSBuildThisFileDirectory)..\..\D2BotNG.sln --project=D2BotNG --properties:SkipUIBuild=true --output=$(BaseIntermediateOutputPath)inspect.sarif --format=Sarif --severity=WARNING" ContinueOnError="true" IgnoreStandardErrorWarningFormat="true">
      <Output TaskParameter="ExitCode" PropertyName="_JbLocalExitCode" />
    </Exec>
    <!-- Fall back to global tool if local tool not available -->
    <Exec Command="jb inspectcode $(MSBuildThisFileDirectory)..\..\D2BotNG.sln --project=D2BotNG --properties:SkipUIBuild=true --output=$(BaseIntermediateOutputPath)inspect.sarif --format=Sarif --severity=WARNING" ContinueOnError="true" Condition="'$(_JbLocalExitCode)' != '0'" />
    <Message Text="ReSharper inspection report: $(BaseIntermediateOutputPath)inspect.sarif" Importance="high" Condition="Exists('$(BaseIntermediateOutputPath)inspect.sarif')" />
  </Target>

  <!--
    The game's data tables, and the lookups over them the capture cannot answer for itself: an
    item's tier, its ItemTypes.txt categories and its equip requirements. It ships the tables as
    embedded resources, so there is no install to locate and no "tables not loaded" state.

    A package rather than the sibling checkout it started as. That was not only tidier: a
    ProjectReference to a netstandard2.0 library needed SetPlatform="Platform=AnyCPU", because a
    SOLUTION build passes Platform=x64 as a global property which propagates into project
    references, and MSBuild then looked for the assembly under bin\x64\ where nothing had built.
    A package has no platform to negotiate, and CI no longer needs a second repository cloned
    beside this one.
  -->
  <ItemGroup>
    <PackageReference Include="D2ItemToolkit" Version="0.4.1" />
  </ItemGroup>

</Project>
